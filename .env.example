# ---- LLM provider (OpenAI-compatible) ----
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
PLANNER_MODEL=
ADVISOR_MODEL=
# 推理型模型的思考 token 也计入 completion 预算；DeepSeek flash 可调到 3000
ADVISOR_MAX_TOKENS=1200
VERIFIER_MODEL=

# ---- Local embedding / rerank (W2+) ----
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# auto 优先 CUDA，CPU 可回退；设备会写入 data/vector_manifest.json
EMBEDDING_DEVICE=auto

# ---- Qdrant (W1 only needs this for `make index-qdrant`) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=articles_v1
# 没有 Docker/Qdrant 服务时，可改用本地持久化模式（仅用于单机 smoke）：
# QDRANT_LOCATION=./data/qdrant_local

# ---- Ingest ----
CAMPUSGUIDE_USER_AGENT=CampusGuideBot/0.1 (academic demo; contact: set-your-email)
CAMPUSGUIDE_HTTP_TIMEOUT=30
