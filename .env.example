# ---- LLM provider (OpenAI-compatible) ----
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
PLANNER_MODEL=
ADVISOR_MODEL=
VERIFIER_MODEL=

# ---- Local embedding / rerank (W2+) ----
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- Qdrant (W1 only needs this for `make index-qdrant`) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=articles_v1

# ---- Ingest ----
CAMPUSGUIDE_USER_AGENT=CampusGuideBot/0.1 (academic demo; contact: set-your-email)
CAMPUSGUIDE_HTTP_TIMEOUT=30
